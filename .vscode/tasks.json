{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: build (dev)",
      "type": "shell",
      "command": "node esbuild.mjs --dev",
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "npm: watch",
      "type": "shell",
      "command": "npm run watch",
      "isBackground": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Package VSIX",
      "type": "shell",
      "command": "npm run package",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run all checks",
      "type": "shell",
      "command": "npm run check",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
