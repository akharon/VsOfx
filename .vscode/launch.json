{
  // Every command goes through scripts/npm.ps1: it uses Node.js from PATH, or a portable
  // Node.js in .tools/ that it downloads once (checksum-verified) when none is installed.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/test/fixtures"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build (dev)"
    },
    {
      "name": "Build VSIX (npm run package)",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/npm.ps1 run package:clean",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Integration Tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/npm.ps1 run test:integration",
      "cwd": "${workspaceFolder}"
    }
  ]
}
